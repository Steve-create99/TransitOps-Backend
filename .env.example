# ============================================================
# TransitOps Backend — Environment template (safe to commit)
# Copy to .env and fill in real values, or paste into Railway.
# ============================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

SPRING_PROFILES_ACTIVE=prod

# Origin only — no /dashboard or other paths
CORS_ORIGINS=https://transitops-frontend.pages.dev,http://localhost:5173

JPA_DDL_AUTO=update
PORT=8080

BOOTSTRAP_ADMIN_EMAIL=admin@transitops.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
